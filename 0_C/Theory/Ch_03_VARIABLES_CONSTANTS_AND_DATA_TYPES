    int main(void)
    {
        int employee_id = 1001;
        char grade = 'A';
        double salary = 55000.75;

        printf("Employee ID : %d\n", employee_id);
        printf("Grade       : %c\n", grade);
        printf("Salary      : %.2f\n", salary);

        return 0;
    }


