85. MINI PROGRAM — AREA OF CIRCLE
------------------------------------------------------------

    #include <stdio.h>

    int main(void)
    {
        const double PI = 3.141592653589793;
        double radius = 10.0;

        double area = PI * radius * radius;

        printf("Area = %.2f\n", area);

        return 0;
    }


