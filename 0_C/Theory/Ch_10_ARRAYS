47. BUBBLE SORT
------------------------------------------------------------

void bubbleSort(int arr[], size_t n)
{
    if (n < 2)
        return;

    for (size_t i = 0; i < n - 1; i++)
    {
        int swapped = 0;

        for (size_t j = 0; j < n - 1 - i; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                int temp = arr[j];

                arr[j] = arr[j + 1];
                arr[j + 1] = temp;

                swapped = 1;
            }
        }

        if (!swapped)
            break;
    }
}


Example:

5 2 4 1

After sorting:

1 2 4 5


