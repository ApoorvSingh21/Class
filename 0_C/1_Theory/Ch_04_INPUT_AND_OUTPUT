============================================================
56. MIXING scanf() AND fgets()
============================================================

This is a common beginner problem.

Example:

    int age;
    char name[50];

    scanf("%d", &age);
    fgets(name, sizeof name, stdin);


User:

    22\n


scanf() consumes:

    22

but leaves:

    \n


Then fgets() immediately reads that newline.


Result:

    name may become "\n"


============================================================
57. BETTER APPROACH
============================================================

For interactive applications, one clean approach is:

    Use fgets() for ALL user input.

Then parse the values.

Example:

    char buffer[100];

    fgets(buffer, sizeof buffer, stdin);


Then parse:

    strtol()
    strtod()
    etc.


This avoids many scanf()/newline problems.


============================================================
58. INPUT VALIDATION
============================================================

Never assume user input is valid.

Example:

    Age should be:

        >= 0
        <= 150


Instead of blindly doing:

    scanf("%d", &age);


Validate the result and range.


Example:

    if (age < 0 || age > 150)
    {
        printf("Invalid age\n");
    }


But first make sure the conversion itself succeeded.


============================================================
59. RANGE VALIDATION
============================================================

Example:

    int marks;

    if (scanf("%d", &marks) == 1)
    {
        if (marks >= 0 && marks <= 100)
        {
            printf("Valid marks\n");
        }
        else
        {
            printf("Marks must be between 0 and 100\n");
        }
    }
    else
    {
        printf("Invalid input\n");
    }


============================================================
60. MENU-DRIVEN PROGRAM
============================================================

Example:

    #include <stdio.h>

    int main(void)
    {
        int choice;

        printf("===== MENU =====\n");
        printf("1. Add\n");
        printf("2. Delete\n");
        printf("3. Exit\n");

        printf("Enter choice: ");

        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input\n");
            return 1;
        }

        switch (choice)
        {
            case 1:
                printf("Add selected\n");
                break;

            case 2:
                printf("Delete selected\n");
                break;

            case 3:
                printf("Exit selected\n");
                break;

            default:
                printf("Invalid choice\n");
        }

        return 0;
    }


This combines:

    input
    output
    conditionals
    switch


============================================================
61. SIMPLE CALCULATOR
============================================================

    #include <stdio.h>

    int main(void)
    {
        double a, b;
        char op;

        printf("Enter expression: ");

        if (scanf("%lf %c %lf", &a, &op, &b) != 3)
        {
            printf("Invalid input\n");
            return 1;
        }

        switch (op)
        {
            case '+':
                printf("Result = %.2f\n", a + b);
                break;

            case '-':
                printf("Result = %.2f\n", a - b);
                break;

            case '*':
                printf("Result = %.2f\n", a * b);
                break;

            case '/':
                if (b == 0.0)
                    printf("Cannot divide by zero\n");
                else
                    printf("Result = %.2f\n", a / b);
                break;

            default:
                printf("Unknown operator\n");
        }

        return 0;
    }


Input:

    10 + 5


Output:

    Result = 15.00


