91. PRACTICAL PROGRAM — REVERSE STRING
------------------------------------------------------------

#include <stdio.h>
#include <string.h>

void reverse(char str[])
{
    size_t left = 0;
    size_t right = strlen(str);

    if (right == 0)
        return;

    right--;

    while (left < right)
    {
        char temp = str[left];

        str[left] = str[right];
        str[right] = temp;

        left++;
        right--;
    }
}

int main(void)
{
    char str[] = "Apoorv";

    reverse(str);

    printf("%s\n", str);

    return 0;
}

Output:

roopA


