92. PRACTICAL PROGRAM — PALINDROME
------------------------------------------------------------

#include <stdio.h>
#include <string.h>

int isPalindrome(const char str[])
{
    size_t left = 0;
    size_t right = strlen(str);

    if (right == 0)
        return 1;

    right--;

    while (left < right)
    {
        if (str[left] != str[right])
            return 0;

        left++;
        right--;
    }

    return 1;
}

int main(void)
{
    char str[] = "madam";

    if (isPalindrome(str))
        printf("Palindrome\n");
    else
        printf("Not Palindrome\n");

    return 0;
}


