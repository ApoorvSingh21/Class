96. PRACTICAL PROGRAM — STRING COPY
------------------------------------------------------------

#include <stdio.h>

void copyString(char dest[],
                size_t capacity,
                const char src[])
{
    if (capacity == 0)
        return;

    size_t i = 0;

    while (src[i] != '\0' && i + 1 < capacity)
    {
        dest[i] = src[i];
        i++;
    }

    dest[i] = '\0';
}

int main(void)
{
    char dest[20];

    copyString(dest, sizeof dest, "Hello");

    printf("%s\n", dest);

    return 0;
}


