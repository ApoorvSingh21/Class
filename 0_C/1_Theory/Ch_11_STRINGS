#include <stdio.h>

void countCharacters(const char str[])
{
    int vowels = 0;
    int digits = 0;
    int spaces = 0;

    for (size_t i = 0; str[i] != '\0'; i++)
    {
        char c = str[i];

        if (c == 'a' || c == 'e' || c == 'i' ||
            c == 'o' || c == 'u' ||
            c == 'A' || c == 'E' || c == 'I' ||
            c == 'O' || c == 'U')
        {
            vowels++;
        }

        if (c >= '0' && c <= '9')
            digits++;

        if (c == ' ')
            spaces++;
    }

    printf("Vowels = %d\n", vowels);
    printf("Digits = %d\n", digits);
    printf("Spaces = %d\n", spaces);
}


