79. PRACTICAL PROGRAM 4 — REVERSE ARRAY
------------------------------------------------------------

    #include <stdio.h>
    #include <stddef.h>

    void reverse(int *arr, size_t n)
    {
        if (n == 0)
            return;

        int *left = arr;
        int *right = arr + n - 1;

        while (left < right)
        {
            int temp = *left;
            *left = *right;
            *right = temp;

            left++;
            right--;
        }
    }

    int main(void)
    {
        int arr[] = {1, 2, 3, 4, 5};

        reverse(arr, sizeof arr / sizeof arr[0]);

        for (size_t i = 0; i < sizeof arr / sizeof arr[0]; i++)
            printf("%d ", arr[i]);

        return 0;
    }

Output:

    5 4 3 2 1

