    int even = 0;
    int odd = 0;

    for (int i = 1; i <= 100; i++)
    {
        if (i % 2 == 0)
            even++;
        else
            odd++;
    }

    printf("Even = %d\n", even);
    printf("Odd = %d\n", odd);


